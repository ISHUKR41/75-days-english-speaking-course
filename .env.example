# ==============================================
# 75 Days Hard English Course - Environment Variables
# ==============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ----------------------------------------------
# DATABASE (Supabase / Neon / PlanetScale)
# ----------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/75days_english"
DIRECT_URL="postgresql://user:password@host:5432/75days_english"

# ----------------------------------------------
# AUTHENTICATION (Clerk)
# ----------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_b3JnYW5pYy1sb25naG9ybi0yNi5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_KEY_HERE
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
CLERK_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ----------------------------------------------
# APP CONFIG
# ----------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="75 Days Hard English Course"
NODE_ENV=development

# ----------------------------------------------
# AI (for speech analysis & question generation)
# ----------------------------------------------
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE
NEXT_PUBLIC_OPENAI_MODEL=gpt-4o-mini

# ----------------------------------------------
# REDIS (for caching & real-time features)
# ----------------------------------------------
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH_URL.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN

# ----------------------------------------------
# EMAIL (Resend)
# ----------------------------------------------
RESEND_API_KEY=re_YOUR_RESEND_KEY_HERE
RESEND_FROM_EMAIL=noreply@75daysenglish.com

# ----------------------------------------------
# STORAGE (Cloudinary for images/audio)
# ----------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_SECRET

# ----------------------------------------------
# ANALYTICS (PostHog)
# ----------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_YOUR_POSTHOG_KEY
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ----------------------------------------------
# SENTRY (Error tracking)
# ----------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/PROJECT_ID
SENTRY_ORG=your-org
SENTRY_PROJECT=75-days-english

# ----------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_ENABLE_SPEECH_RECOGNITION=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true
NEXT_PUBLIC_ENABLE_GAMIFICATION=true

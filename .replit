modules = ["nodejs-20", "web", "python-base-3.13"]
[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "set -e; npm install --prefer-offline --no-audit --no-fund; cd apps/web; rm -rf .next; export DATABASE_URL='file:./dev.db'; npx prisma db push --accept-data-loss; npx tsx prisma/seed.ts; npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5010
externalPort = 3002

[[ports]]
localPort = 5050
externalPort = 3003

[userenv]

[userenv.shared]
NEXT_PUBLIC_APP_NAME = "75 Days Hard English Course"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY = "pk_test_b3JnYW5pYy1sb25naG9ybi0yNi5jbGVyay5hY2NvdW50cy5kZXYk"
NEXT_PUBLIC_CLERK_SIGN_IN_URL = "/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL = "/sign-up"
NEXT_PUBLIC_ENABLE_GAMIFICATION = "true"
NEXT_PUBLIC_ENABLE_SPEECH_RECOGNITION = "true"
NEXT_PUBLIC_APP_URL = "https://75days-english.replit.app"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL = "/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL = "/dashboard"
NEXT_PUBLIC_ENABLE_AI_FEATURES = "true"

# ============================================================
# .env.example — Environment variables for 75 Days Hard English
# Copy this to .env.local and fill in your values.
# Never commit .env.local — it contains real secrets.
# ============================================================

# ── Database ──────────────────────────────────────────────────
# SQLite path for local development
DATABASE_URL="file:./dev.db"

# ── Clerk Authentication ───────────────────────────────────────
# Get these from https://dashboard.clerk.com
# The app runs in DEV PASSTHROUGH mode when these are absent or
# set to placeholder values — all pages work without real auth.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_SECRET

# Clerk URL routing — do not change these values
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── App Settings ───────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="75 Days Hard English Course"
NEXT_PUBLIC_APP_URL=http://localhost:5000

# ── Feature Flags ──────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_GAMIFICATION=true
NEXT_PUBLIC_ENABLE_SPEECH_RECOGNITION=true

# ── OpenAI (optional — only needed for AI-powered features) ───
# OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY
